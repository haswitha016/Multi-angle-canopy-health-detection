# Copy this file to .env and adjust paths/settings for your machine.
# Dataset should eventually contain train/, validation/, and test/ splits.
DATASET_DIR=./data
MODEL_PATH=./models/canopy_health_best.pth
UPLOAD_DIR=./static/uploads
REPORT_DIR=./reports

# Application defaults for later stages
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
MAX_CONTENT_LENGTH_MB=20
